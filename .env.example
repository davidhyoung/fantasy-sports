DATABASE_URL=postgres://fantasy:fantasy@localhost:5432/fantasy_sports
PORT=8080

YAHOO_CLIENT_ID=your_yahoo_client_id
YAHOO_CLIENT_SECRET=your_yahoo_client_secret
YAHOO_REDIRECT_URL=http://localhost:8080/auth/callback

SESSION_SECRET=change-me-to-a-random-32-plus-char-string

# Development only. YAHOO_MOCK=1 serves synthetic Yahoo Fantasy data instead of
# calling the real API, and exposes /auth/mock-login which grants a session with
# NO authentication. Never set this in a deployed environment.
# YAHOO_MOCK=1
